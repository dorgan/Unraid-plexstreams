<?php
foreach($serverTypes as $serverType) {
    $typeIdx = strtolower($serverType);
    echo <<<EOF
        <fieldset id="{$typeIdx}-servers">
            <legend>{$serverType}</legend>
            <button class="psAddServerIcon" onclick="addServer('{$typeIdx}');">+ Add Server</button>
    EOF;
    if (isset($cfg[$typeIdx])) {
        foreach($cfg[$typeIdx] as $mediaServerSettings) {
            $server = new MediaServer($mediaServerSettings);
        }
    }
    echo <<<EOF
        </fieldset>
    EOF;
}
?>


