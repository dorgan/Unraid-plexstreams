<script src="<?autov('/plugins/plexstreams/js/plex.js')?>"></script>
<script>
  var initialMediaServers = <?php echo json_encode($editableMediaServers, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT); ?>;

  (function() {
    var list = document.getElementById('plexstreams-media-server-list');
    var emptyState = document.getElementById('plexstreams-media-server-empty');
    var registryField = document.getElementById('MEDIA_SERVERS');
    var form = document.getElementById('plexstreams_settings');
    var tokenField = document.getElementById('TOKEN');
    var tokenButton = document.getElementById('plexstreams-token-button');
    var plexConnections = [];
    var plexTokenValid = false;

    function updatePlexAvailability() {
      tokenButton.classList.toggle('is-connected', plexTokenValid);
      tokenButton.innerHTML = plexTokenValid ? '<i class="fa fa-check"></i> Plex connected' : '<i class="fa fa-key"></i> Connect Plex';
      Array.prototype.forEach.call(document.querySelectorAll('.media-server-provider option[value="plex"]'), function(option) {
        option.disabled = !plexTokenValid;
      });
    }

    function refreshPlexConnections(token) {
      plexTokenValid = false;
      updatePlexAvailability();
      if (!token) return;
      tokenButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Checking Plex';
      $.ajax({ url: '/plugins/plexstreams/getServers.php', method: 'POST', dataType: 'json', data: { useSsl: document.getElementById('FORCE_PLEX_HTTPS').value, token: token } }).done(function(data) {
        plexConnections = [];
        Object.keys(data.serverList || {}).forEach(function(id) {
          var server = data.serverList[id];
          (server.Connections || []).forEach(function(connection) {
            if (connection && connection.uri) plexConnections.push({ url: connection.uri, name: server.Name || 'Plex' });
          });
        });
        plexTokenValid = true;
        updatePlexAvailability();
        Array.prototype.forEach.call(document.querySelectorAll('.media-server-plex-url'), function(select) { populatePlexConnections(select); select.dispatchEvent(new Event('change')); });
      }).fail(function() {
        plexTokenValid = false;
        updatePlexAvailability();
      });
    }

    tokenButton.addEventListener('click', function() {
      PlexOAuth(function(token) { tokenField.value = token; refreshPlexConnections(token); });
    });

    Array.prototype.forEach.call(document.querySelectorAll('.plexstreams-switch input[data-setting]'), function(toggle) {
      var target = document.getElementById(toggle.dataset.setting);
      var label = toggle.parentNode.querySelector('.plexstreams-switch-label');
      function syncToggle() {
        var onValue = toggle.dataset.on || '1';
        var offValue = toggle.dataset.off || '0';
        target.value = toggle.checked ? onValue : offValue;
        label.textContent = toggle.dataset.setting === 'DASHBOARD_LAYOUT' ? (toggle.checked ? 'Condensed' : 'Default') : (toggle.checked ? 'On' : 'Off');
      }
      toggle.addEventListener('change', function() {
        var switchControl = toggle.parentNode;
        switchControl.classList.remove('is-changing');
        void switchControl.offsetWidth;
        switchControl.classList.add('is-changing');
        window.setTimeout(function() { switchControl.classList.remove('is-changing'); }, 360);
        syncToggle();
      });
      syncToggle();
    });

    function field(labelText, className, type) {
      var label = document.createElement('label');
      var input = document.createElement(type === 'select' ? 'select' : 'input');
      label.appendChild(document.createTextNode(labelText));
      input.className = className;
      if (type !== 'select') input.type = type;
      label.appendChild(input);
      return label;
    }

    function updateEmptyState() {
      emptyState.style.display = list.children.length ? 'none' : '';
    }

    function placeServerCard(card, provider) {
      if (provider === 'plex') {
        var firstNonPlex = Array.prototype.find.call(list.children, function(candidate) {
          return candidate.querySelector('.media-server-provider').value !== 'plex';
        });
        list.insertBefore(card, firstNonPlex || null);
      } else if (card.parentNode === list) {
        list.appendChild(card);
      }
      card.classList.remove('is-reordering');
      void card.offsetWidth;
      card.classList.add('is-reordering');
      window.setTimeout(function() { card.classList.remove('is-reordering'); }, 280);
    }

    function populatePlexConnections(select, selectedUrl) {
      var currentUrl = selectedUrl || select.dataset.selectedUrl || '';
      select.textContent = '';
      var placeholder = document.createElement('option'); placeholder.value = ''; placeholder.textContent = 'Select a Plex server'; select.appendChild(placeholder);
      plexConnections.forEach(function(connection) {
        var option = document.createElement('option'); option.value = connection.url; option.textContent = connection.name + ' · ' + connection.url; select.appendChild(option);
      });
      var hasSelection = plexConnections.some(function(connection) { return connection.url === currentUrl; });
      var custom = document.createElement('option'); custom.value = '__custom__'; custom.textContent = 'Custom server URL'; select.appendChild(custom);
      select.value = hasSelection ? currentUrl : '__custom__';
      select.dataset.selectedUrl = currentUrl;
    }

    function createServerCard(server) {
      server = server || { provider: 'jellyfin', name: 'Jellyfin', baseUrl: '', apiKey: '' };
      var card = document.createElement('article');
      card.className = 'plexstreams-media-server is-entering';
      card.dataset.id = server.id || '';
      var header = document.createElement('div');
      header.className = 'plexstreams-media-server-header';
      var title = document.createElement('strong');
      title.textContent = 'Additional media server';
      var remove = document.createElement('button');
      remove.type = 'button'; remove.className = 'plexstreams-remove-server'; remove.title = 'Remove server';
      remove.innerHTML = '<i class="fa fa-trash"></i><span class="hidden">Remove server</span>';
      remove.addEventListener('click', function() {
        card.classList.add('is-removing');
        window.setTimeout(function() { card.remove(); updateEmptyState(); }, 240);
      });
      header.appendChild(title); header.appendChild(remove); card.appendChild(header);
      var fields = document.createElement('div'); fields.className = 'plexstreams-media-server-fields';
      var providerLabel = field('Provider', 'media-server-provider', 'select');
      [['plex', 'Plex'], ['jellyfin', 'Jellyfin'], ['emby', 'Emby']].forEach(function(option) {
        var element = document.createElement('option'); element.value = option[0]; element.textContent = option[1]; providerLabel.lastChild.appendChild(element);
      });
      providerLabel.lastChild.value = server.provider || 'plex';
      var nameLabel = field('Display name', 'media-server-name', 'text'); nameLabel.lastChild.value = server.name || '';
      var urlLabel = field('Server URL', 'media-server-url', 'text'); urlLabel.lastChild.placeholder = 'http://server.example:8096'; urlLabel.lastChild.value = server.baseUrl || '';
      var plexUrlSelect = document.createElement('select'); plexUrlSelect.className = 'media-server-plex-url'; urlLabel.insertBefore(plexUrlSelect, urlLabel.lastChild); populatePlexConnections(plexUrlSelect, server.baseUrl || '');
      var keyLabel = field('API key', 'media-server-key', 'password'); keyLabel.lastChild.autocomplete = 'new-password'; keyLabel.lastChild.value = server.apiKey || '';
      var customUrlLabel = field('Custom server URL', 'media-server-custom-url', 'text'); customUrlLabel.lastChild.placeholder = 'http://server.example:32400'; customUrlLabel.lastChild.value = server.baseUrl || '';
      fields.appendChild(providerLabel); fields.appendChild(nameLabel); fields.appendChild(urlLabel); fields.appendChild(keyLabel); fields.appendChild(customUrlLabel); card.appendChild(fields);
      function updateProviderFields() {
        var isPlex = providerLabel.lastChild.value === 'plex';
        urlLabel.firstChild.nodeValue = isPlex ? 'Plex server' : 'Server URL';
        plexUrlSelect.style.display = isPlex ? '' : 'none';
        urlLabel.lastChild.style.display = isPlex ? 'none' : '';
        keyLabel.style.display = isPlex ? 'none' : '';
        customUrlLabel.style.display = isPlex && plexUrlSelect.value === '__custom__' ? '' : 'none';
        keyLabel.lastChild.disabled = isPlex;
        keyLabel.lastChild.placeholder = 'Paste API key';
      }
      providerLabel.lastChild.addEventListener('change', function() {
        updateProviderFields();
        placeServerCard(card, providerLabel.lastChild.value);
      });
      plexUrlSelect.addEventListener('change', function() { updateProviderFields(); });
      updateProviderFields();
      list.appendChild(card); updateEmptyState();
      window.requestAnimationFrame(function() { card.classList.remove('is-entering'); });
      return card;
    }

    function encodeRegistry(value) {
      return btoa(unescape(encodeURIComponent(JSON.stringify(value))));
    }

    document.querySelector('.plexstreams-add-server').addEventListener('click', function() { createServerCard(); });
    var orderedInitialMediaServers = (initialMediaServers || []).filter(function(server) { return server.provider === 'plex'; }).concat((initialMediaServers || []).filter(function(server) { return server.provider !== 'plex'; }));
    orderedInitialMediaServers.forEach(createServerCard);
    updateEmptyState();
    updatePlexAvailability();
    refreshPlexConnections(tokenField.value);
    form.addEventListener('submit', function(event) {
      var error = form.querySelector('.plexstreams-media-server-validation');
      if (error) error.remove();
      var valid = true;
      var plexHosts = [];
      Array.prototype.slice.call(form.querySelectorAll('.plexstreams-generated-alias')).forEach(function(input) { input.remove(); });
      var servers = Array.prototype.map.call(list.children, function(card, index) {
        var provider = card.querySelector('.media-server-provider').value;
        var name = card.querySelector('.media-server-name').value.trim();
        var urlInput = card.querySelector('.media-server-url');
        var plexUrlSelect = card.querySelector('.media-server-plex-url');
        var customUrlInput = card.querySelector('.media-server-custom-url');
        var baseUrl = (provider === 'plex' ? (plexUrlSelect.value === '__custom__' ? customUrlInput.value : plexUrlSelect.value) : urlInput.value).trim().replace(/\/$/, '');
        var apiKey = card.querySelector('.media-server-key').value.trim();
        try { var parsedUrl = new URL(baseUrl); valid = valid && (parsedUrl.protocol === 'http:' || parsedUrl.protocol === 'https:'); } catch (e) { valid = false; }
        valid = valid && Boolean(name && (provider === 'plex' ? plexTokenValid : apiKey));
        if (provider === 'plex') {
          plexHosts.push(baseUrl);
          var alias = document.createElement('input');
          var aliasHost = baseUrl.replace(/^https?:\/\//, '').split('/')[0].split(':')[0].replace(/\./g, '_');
          alias.type = 'hidden'; alias.className = 'plexstreams-generated-alias';
          alias.name = 'ALIAS-' + aliasHost; alias.value = name;
          form.appendChild(alias);
        }
        return { id: card.dataset.id || provider + '-' + Date.now().toString(36) + '-' + index, provider: provider, name: name, baseUrl: baseUrl, apiKey: apiKey };
      });
      if (!valid) {
        event.preventDefault();
        error = document.createElement('p'); error.className = 'plexstreams-media-server-validation'; error.textContent = 'Each server needs a display name and an http(s) URL. Jellyfin and Emby require API keys; Plex must be connected first.'; form.querySelector('.plexstreams-media-servers').appendChild(error); return;
      }
      document.getElementById('HOST').value = plexHosts.join(',');
      document.getElementById('CUSTOM_SERVERS').value = '';
      registryField.value = encodeRegistry({ version: 1, servers: servers.filter(function(server) { return server.provider !== 'plex'; }) });
    });
  })();
